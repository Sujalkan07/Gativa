# Frontend Environment Variables
# Copy this file to .env and configure as needed.
# Note: Vite embeds VITE_* variables into client bundles at build time.
# NEVER put server-only credentials here. Restrict client keys by domain/origin on the provider console.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# MAP PROVIDER CREDENTIALS (INDEPENDENT PROVIDERS)
# ------------------------------------------------------------------------------

# 1. CARTO Basemap API Key (Street Basemap Rendering)
# Required for CARTO Voyager raster tiles (https://carto.com/basemaps/apikey).
# If omitted or invalid, Gativa automatically falls back to OpenStreetMap tiles.
# Do NOT use TomTom credentials here.
VITE_CARTO_BASEMAP_API_KEY=your_carto_api_key_here

# 2. TomTom API Key (Live Traffic Flow Overlay)
# Used specifically for the real-time traffic flow tile layer overlay (TomTom Traffic API v4).
# Register a free key at https://developer.tomtom.com/
# If omitted, live traffic overlay is disabled, but basemap rendering continues normally.
# Do NOT append this key to CARTO URLs.
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here
