# Frontend Environment Variables
# Copy this file to .env and configure as needed.
# Note: Vite statically embeds VITE_* variables into client bundles at build time.
# NEVER put server-only credentials here. Restrict client keys by domain/origin on the provider console.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# MAP PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------

# 1. TomTom API Key (Primary Street Basemap & Live Traffic Flow Overlay)
# Required for:
#   a) TomTom Maps Display API v1 (Street Basemap: /map/1/tile/basic/main/...)
#   b) TomTom Traffic Flow API v4 (Live Traffic Overlay: /traffic/map/4/tile/flow/...)
# Register a free API key at https://developer.tomtom.com/ (ensure Map Display and Traffic Flow permissions are enabled).
# If omitted or invalid, Gativa automatically falls back to OpenStreetMap for the basemap.
# Contrast with backend TOMTOM_API_KEY: VITE_TOMTOM_API_KEY is browser-visible client configuration.
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# 2. CARTO Basemap API Key (Optional Alternative Basemap)
# Required only if CARTO Voyager raster tiles are explicitly selected.
# Obtain a key at https://carto.com/basemaps/apikey
VITE_CARTO_BASEMAP_API_KEY=your_carto_api_key_here
